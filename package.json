{
  "name": "proxyflow",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:deployment": "bash scripts/proxyflow.test.sh",
    "loon:acceptance": "node scripts/generate-loon-acceptance.mjs",
    "loon:acceptance:local": "node scripts/generate-loon-acceptance.mjs --local",
    "loon:service-rules:acceptance": "node scripts/generate-loon-service-rules-acceptance.mjs",
    "loon:service-rules:acceptance:local": "node scripts/generate-loon-service-rules-acceptance.mjs --local",
    "loon:precedence:acceptance": "node scripts/generate-loon-routing-precedence-acceptance.mjs",
    "test:watch": "vitest",
    "runtime:build": "vite build --config runtime/vite.config.ts",
    "runtime:start": "node runtime-dist/server.js"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
